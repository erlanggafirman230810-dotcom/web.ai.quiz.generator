import React, { useState, useEffect } from 'react';
import { Settings, BookOpen, Send, ClipboardCheck, Layout } from 'lucide-react';

function App() {
  const [apiKey, setApiKey] = useState('');
  const [subject, setSubject] = useState('');
  const [grade, setGrade] = useState('IX');
  const [topic, setTopic] = useState('');
  const [cogLevel, setCogLevel] = useState('C3');
  const [result, setResult] = useState('');
  const [loading, setLoading] = useState(false);

  // Simpan & Ambil API Key dari memori browser
  useEffect(() => {
    const savedKey = localStorage.getItem('gemini_api_key');
    if (savedKey) setApiKey(savedKey);
  }, []);

  const saveKey = (key) => {
    setApiKey(key);
    localStorage.setItem('gemini_api_key', key);
  };

  const generateSoal = async () => {
    if (!apiKey) return alert("Isi API Key dulu, Bro!");
    setLoading(true);
    
    const prompt = `
      Buatlah 5 soal pilihan ganda untuk jenjang Kelas ${grade}, mata pelajaran ${subject}.
      Topik: ${topic}. 
      Target Level Kognitif: ${cogLevel} (Taksonomi Bloom).
      Format: Soal, Pilihan A-E, dan Kunci Jawaban di akhir.
    `;

    try {
      const resp = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${apiKey}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ contents: [{ parts: [{ text: prompt }] }] })
      });
      const data = await resp.json();
      setResult(data.candidates[0].content.parts[0].text);
    } catch (err) {
      alert("Error: " + err.message);
    } finally {
      setLoading(false);
    }
  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-900 font-sans p-4 md:p-8">
      {/* Header */}
      <header className="max-w-4xl mx-auto mb-8 flex justify-between items-center">
        <div className="flex items-center gap-2">
          <Layout className="text-blue-600" />
          <h1 className="text-2xl font-bold tracking-tight">BantuGuru <span className="text-blue-600">Web</span></h1>
        </div>
        <div className="flex items-center gap-2 bg-white p-2 rounded-lg border shadow-sm">
          <Settings size={18} className="text-slate-400" />
          <input 
            type="password" 
            placeholder="Paste Gemini API Key" 
            className="text-sm outline-none w-40"
            value={apiKey}
            onChange={(e) => saveKey(e.target.value)}
          />
        </div>
      </header>

      <main className="max-w-4xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Panel Input */}
        <div className="md:col-span-1 space-y-4">
          <div className="bg-white p-6 rounded-2xl border shadow-sm space-y-4">
            <div>
              <label className="text-xs font-semibold uppercase text-slate-500">Mata Pelajaran</label>
              <input type="text" className="w-full mt-1 p-2 bg-slate-100 rounded-lg outline-none focus:ring-2 ring-blue-500" 
                value={subject} onChange={(e) => setSubject(e.target.value)} placeholder="Contoh: IPA" />
            </div>
            <div>
              <label className="text-xs font-semibold uppercase text-slate-500">Topik Materi</label>
              <textarea className="w-full mt-1 p-2 bg-slate-100 rounded-lg outline-none h-24" 
                value={topic} onChange={(e) => setTopic(e.target.value)} placeholder="Contoh: Listrik Statis" />
            </div>
            <div className="grid grid-cols-2 gap-2">
              <div>
                <label className="text-xs font-semibold uppercase text-slate-500">Kelas</label>
                <select className="w-full mt-1 p-2 bg-slate-100 rounded-lg" value={grade} onChange={(e) => setGrade(e.target.value)}>
                  <option>VII</option><option>VIII</option><option>IX</option>
                </select>
              </div>
              <div>
                <label className="text-xs font-semibold uppercase text-slate-500">Level</label>
                <select className="w-full mt-1 p-2 bg-slate-100 rounded-lg" value={cogLevel} onChange={(e) => setCogLevel(e.target.value)}>
                  <option>C1</option><option>C2</option><option>C3</option><option>C4</option><option>C5</option><option>C6</option>
                </select>
              </div>
            </div>
            <button 
              onClick={generateSoal}
              disabled={loading}
              className="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl transition-all flex justify-center items-center gap-2"
            >
              {loading ? "Proses..." : <><Send size={18}/> Buat Soal</>}
            </button>
          </div>
        </div>

        {/* Panel Hasil */}
        <div className="md:col-span-2">
          <div className="bg-white p-6 rounded-2xl border shadow-sm h-full min-h-[400px] flex flex-col">
            <div className="flex justify-between items-center mb-4">
              <h2 className="font-bold flex items-center gap-2"><BookOpen size={20}/> Hasil Generate</h2>
              {result && (
                <button onClick={() => navigator.clipboard.writeText(result)} className="text-xs bg-slate-100 px-3 py-1 rounded-full flex items-center gap-1 hover:bg-slate-200">
                  <ClipboardCheck size={14}/> Salin Semua
                </button>
              )}
            </div>
            <div className="flex-1 bg-slate-50 rounded-xl p-4 overflow-auto whitespace-pre-wrap text-sm leading-relaxed border-inner">
              {result || "Belum ada soal. Silahkan isi form dan klik Buat Soal."}
            </div>
          </div>
        </div>
      </main>
    </div>
  );
}

export default App;
